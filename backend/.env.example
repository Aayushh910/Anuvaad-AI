# Application Configuration
APP_NAME=Multimodal PDF RAG Assistant
APP_ENV=development
API_V1_PREFIX=/api/v1

# Groq Cloud API Credentials (Get free key at: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM Models
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Feature Flags
# Set to 'true' to asynchronously generate vision descriptions for extracted PDF figures/charts
DOCDUMIND_GENERATE_IMAGE_DESCRIPTIONS=true